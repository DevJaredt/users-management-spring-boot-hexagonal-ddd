# =============================================================================
# Ejemplo de variables de entorno para desarrollo local (docker compose).
# Copialo a `.env` y completa los valores reales. Nunca subas `.env` a Git.
#
#   cp .env.example .env
#   docker compose up --build
# =============================================================================

# --- Servicio notifiers: relay SMTP de Brevo -------------------------------
# Credenciales en Brevo: SMTP & API -> SMTP.
#   - Login: el que muestra Brevo (formato beXXXXXXX@smtp-brevo.com).
#   - Password: pulsa "Open SMTP key settings" y genera/copia la SMTP key.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USERNAME=be4003001@smtp-brevo.com
BREVO_SMTP_PASSWORD=xsmtpsib-...
BREVO_FROM_ADDRESS=remitente@verificado.com
BREVO_FROM_NAME=Gestion de Usuarios

# Puerto 465 (SSL) en lugar de 587/2525 (STARTTLS):
# BREVO_SMTP_PORT=465
# BREVO_SMTP_STARTTLS=false
# BREVO_SMTP_SSL=true
#
# En el plan free de Render los puertos 25/465/587 estan bloqueados: usa 2525.
# BREVO_SMTP_PORT=2525
