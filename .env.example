# =============================================================================
# Ejemplo de variables de entorno para desarrollo local (docker compose).
# Copialo a `.env` y completa los valores reales. Nunca subas `.env` a Git.
#
#   cp .env.example .env
#   docker compose up --build
# =============================================================================

# --- Guía 9: Backblaze B2 (obligatorio) -------------------------------------
# Bucket privado + Application Key restringida a ese bucket (Read and Write).
# B2_ENABLED=false arranca sin almacenamiento (los endpoints de archivos dan 503).
B2_ENABLED=false
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_BUCKET=usuarios-lab-2026
B2_KEY_ID=keyID-de-la-application-key
B2_APPLICATION_KEY=applicationKey-de-la-application-key
B2_MAX_FILE_SIZE_BYTES=5242880

# --- Guía 10: Valkey/Redis en Aiven (obligatorio) ---------------------------
# Se usa la Service URI de Aiven. El esquema rediss:// activa TLS.
# CACHE_ENABLED=false arranca sin caché (siempre lee de MySQL).
CACHE_ENABLED=false
CACHE_URI=rediss://default:CONTRASENA@host-aiven:15426
CACHE_TTL_SECONDS=300
CACHE_KEY_PREFIX=users:by-id:

# --- Guía 11: OpenSearch en Aiven (opcional / nota alta) --------------------
# Credenciales de la pestaña OpenSearch -> Connection information.
# OPENSEARCH_ENABLED=false arranca search sin índice (los endpoints dan 503).
OPENSEARCH_ENABLED=false
OPENSEARCH_URL=https://host-aiven:15425
OPENSEARCH_USERNAME=avnadmin
OPENSEARCH_PASSWORD=CONTRASENA
OPENSEARCH_INDEX=users

# --- Servicio notifiers: relay SMTP de Brevo -------------------------------
# Credenciales en Brevo: SMTP & API -> SMTP.
#   - Login: el que muestra Brevo (formato beXXXXXXX@smtp-brevo.com).
#   - Password: pulsa "Open SMTP key settings" y genera/copia la SMTP key.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USERNAME=be4003001@smtp-brevo.com
BREVO_SMTP_PASSWORD=xsmtpsib-...
BREVO_FROM_ADDRESS=remitente@verificado.com
BREVO_FROM_NAME=Gestion de Usuarios

# Puerto 465 (SSL) en lugar de 587/2525 (STARTTLS):
# BREVO_SMTP_PORT=465
# BREVO_SMTP_STARTTLS=false
# BREVO_SMTP_SSL=true
#
# En el plan free de Render los puertos 25/465/587 estan bloqueados: usa 2525.
# BREVO_SMTP_PORT=2525
