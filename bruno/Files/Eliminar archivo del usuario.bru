meta {
  name: Eliminar archivo del usuario
  type: http
  seq: 4
}

delete {
  url: {{usersBaseUrl}}/api/users/{{userId}}/files/{{fileName}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
