meta {
  name: Crear usuario
  type: http
  seq: 1
}

post {
  url: {{usersBaseUrl}}/api/users
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id": "{{newUserId}}",
    "name": "Sahir David",
    "email": "alvaronarvaez.dev@gmail.com",
    "password": "alvaro123!",
    "role": "MEMBER"
  }
}

script:pre-request {
  const uuid = "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx".replace(/[xy]/g, function (c) {
    const r = (Math.random() * 16) | 0;
    const v = c === "x" ? r : (r & 0x3) | 0x8;
    return v.toString(16);
  });
  bru.setVar("newUserId", uuid);
  bru.setVar("newUserEmail", "bruno+" + Date.now() + "@example.com");
}

script:post-response {
  bru.setVar("userId", res.getBody().id);
  bru.setVar("userEmail", res.getBody().email);
}

tests {
  test("201 Created y status inicial PENDING", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().status).to.equal("PENDING");
  });
}
