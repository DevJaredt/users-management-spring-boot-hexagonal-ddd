meta {
  name: Correo de prueba (SMTP Brevo)
  type: http
  seq: 1
}

post {
  url: {{notifiersBaseUrl}}/api/notifications/test-email
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{testRecipient}}",
    "name": "Bruno"
  }
}

tests {
  test("202 Accepted (correo enviado)", function () {
    expect(res.getStatus()).to.equal(202);
  });
}
